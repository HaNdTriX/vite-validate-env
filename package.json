{
  "name": "vite-plugin-validate-env",
  "type": "module",
  "version": "0.1.1",
  "$schema": "https://raw.githubusercontent.com/vitejs/vite-plugin-registry/refs/heads/main/data/schema/extended-package-json.schema.json",
  "packageManager": "pnpm@10.33.0",
  "description": "Vite plugin to validate environment variables against any standard schema library (Zod, Valibot, ArkType).",
  "author": "Henrik Wenz <handtrix@mail.com>",
  "license": "MIT",
  "keywords": [
    "vite-plugin",
    "vite",
    "env",
    "validation",
    "standard-schema"
  ],
  "homepage": "https://github.com/handtrix/vite-plugin-validate-env#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handtrix/vite-plugin-validate-env.git"
  },
  "bugs": {
    "url": "https://github.com/handtrix/vite-plugin-validate-env/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "@vitest/coverage-v8": "4.1.4",
    "bumpp": "^11.0.1",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "compatiblePackages": {
    "schemaVersion": 1,
    "vite": {
      "type": "compatible",
      "versions": ">=5"
    },
    "rollup": {
      "type": "incompatible",
      "reason": "This plugin depends on Vite-specific APIs and cannot run directly in Rollup config."
    },
    "rolldown": {
      "type": "incompatible",
      "reason": "This plugin depends on Vite-specific APIs and cannot run directly in Rolldown config."
    }
  }
}
