{
  "name": "vite-validate-env",
  "type": "module",
  "version": "0.0.2",
  "packageManager": "pnpm@10.33.0",
  "description": "Vite plugin to validate environment variables against any standard schema library (Zod, Valibot, ArkType).",
  "author": "Henrik Wenz <handtrix@mail.com>",
  "license": "MIT",
  "homepage": "https://github.com/handtrix/vite-validate-env#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handtrix/vite-validate-env.git"
  },
  "bugs": {
    "url": "https://github.com/handtrix/vite-validate-env/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "@vitest/coverage-v8": "4.1.4",
    "bumpp": "^11.0.1",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "vite": ">=5"
  }
}
